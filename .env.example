# Audio Stream Configuration
STREAM_URL=https://stream.durhampolicescanner.com/
SAMPLE_RATE=16000
CHUNK_DURATION_MS=5000
OVERLAP_MS=1000

# Transcription Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LANGUAGE=en

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Output Configuration
OUTPUT_FILE=transcripts/transcript.jsonl
MAX_LOG_SIZE_MB=100
LOG_RETENTION_DAYS=7
# Dashboard feed/summary history, reloaded from the transcript files on restart
HISTORY_RETENTION_HOURS=4

# Summary Configuration (any OpenAI-compatible endpoint, e.g. llama-server)
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=nanbeige-4.2-3b
# LLM_API_KEY=
# LLM_DISABLE_THINKING=true
