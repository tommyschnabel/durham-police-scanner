# .env.local - Local environment overrides for Docker
# Copy this file to .env.local and customize
# Then run: docker-compose --env-file .env.local up -d

# Audio Stream Configuration
STREAM_URL=https://stream.durhampolicescanner.com/

# Transcription Configuration - Better quality for production
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LANGUAGE=en

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Output Configuration
OUTPUT_FILE=transcripts/transcript.jsonl
MAX_LOG_SIZE_MB=100
LOG_RETENTION_DAYS=30
